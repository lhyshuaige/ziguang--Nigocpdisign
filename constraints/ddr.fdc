create_generated_clock -name {phy_dq_clk_1} -source [get_ports {clk_125m_p}] [get_pins {u_ddr3.u_hmic.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {2}
