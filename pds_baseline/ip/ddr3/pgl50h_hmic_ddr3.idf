    <!--
      Bank3 x32 byte-lane placement for the PGL50H FBG484 board.
      These hidden parameters are normally populated by the HMIC GUI.  They
      must be explicit in a hand-maintained IDF; otherwise DQx_EN defaults to
      zero and the generated ddrphy_ioclk_dq[] assignments are omitted.

      DQS0 N3/N1  -> G4 (region 1, DQSL_6_180)
      DQS1 V2/V1  -> G5 (region 1, DQSL_6_152)
      DQS2 M6/L6  -> G3 (region 1, DQSL_6_224)
      DQS3 E3/E1  -> G2 (region 0, DQSL_6_276)
    -->
    <param>
            <name>DQ0_EN</name>
            <value>1</value>
        </param>
    <param>
            <name>DQ1_EN</name>
            <value>1</value>
        </param>
