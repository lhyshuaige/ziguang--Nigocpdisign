# Registered partition timing contracts for pll_clk_sys = 100 MHz.
# Replace the endpoint templates with post-map hierarchy names before enabling.
create_clock -name {pll_clk_sys} [get_ports {clk}] -period {10.000} -waveform {0.000 5.000}
set_clock_uncertainty {0.200} [get_clocks {pll_clk_sys}] -setup -hold

# Each module owns its internal timing. The parent reserves 0.8 ns at each
# registered boundary. These are visible max-delay checks, not false paths.
# set_max_delay {8.000} -from [get_cells {<cpu_boundary_source_regs>}] \
#   -to [get_cells {<cpu_boundary_sink_regs>}]
# set_max_delay {8.000} -from [get_cells {<ai_boundary_source_regs>}] \
#   -to [get_cells {<ai_boundary_sink_regs>}]
# set_max_delay {8.000} -from [get_cells {<dma_boundary_source_regs>}] \
#   -to [get_cells {<dma_boundary_sink_regs>}]
# set_max_delay {7.800} -from [get_cells {<fabric_boundary_source_regs>}] \
#   -to [get_cells {<fabric_boundary_sink_regs>}]

# The HMIC crossing is CDC-checked by the mailbox synchronizers. Do not use a
# broad false path for the whole AXI bus; only the approved synchronizer paths
# may be excluded after reviewing the CDC report.
