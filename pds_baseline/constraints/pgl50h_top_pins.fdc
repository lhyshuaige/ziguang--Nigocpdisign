### PGL50H-6IFBG484 / MES50H-Ethernet board pin constraints
###
### The DDR3 controller's generated Bank3 constraints live in
### ip/ddr3/pnr/ddr_test.fdc.  This file constrains the SoC wrapper ports,
### including the clock, user I/O, QSPI, and the wrapper-to-HMIC DDR pins.

define_attribute {p:clk_50m} {PAP_IO_LOC} {P20}
define_attribute {p:clk_50m} {PAP_IO_DIRECTION} {INPUT}

define_attribute {p:key_n[0]} {PAP_IO_LOC} {U6}
define_attribute {p:key_n[1]} {PAP_IO_LOC} {T7}
define_attribute {p:key_n[2]} {PAP_IO_LOC} {W9}
define_attribute {p:key_n[3]} {PAP_IO_LOC} {Y8}
define_attribute {p:key_n[4]} {PAP_IO_LOC} {Y7}
define_attribute {p:key_n[5]} {PAP_IO_LOC} {AB7}
define_attribute {p:key_n[6]} {PAP_IO_LOC} {AA6}
define_attribute {p:key_n[7]} {PAP_IO_LOC} {AB6}
define_attribute {p:led[0]} {PAP_IO_LOC} {F9}
define_attribute {p:led[1]} {PAP_IO_LOC} {G8}
define_attribute {p:led[2]} {PAP_IO_LOC} {E6}
define_attribute {p:led[3]} {PAP_IO_LOC} {E5}
define_attribute {p:led[4]} {PAP_IO_LOC} {A4}
define_attribute {p:led[5]} {PAP_IO_LOC} {C4}
define_attribute {p:led[6]} {PAP_IO_LOC} {D5}
define_attribute {p:led[7]} {PAP_IO_LOC} {D4}

define_attribute {p:qspi_cs_n} {PAP_IO_LOC} {AA3}
define_attribute {p:qspi_sck} {PAP_IO_LOC} {Y20}
define_attribute {p:qspi_dq[0]} {PAP_IO_LOC} {AB20}
define_attribute {p:qspi_dq[1]} {PAP_IO_LOC} {AA20}
define_attribute {p:qspi_dq[2]} {PAP_IO_LOC} {R13}
define_attribute {p:qspi_dq[3]} {PAP_IO_LOC} {T14}

### HMIC Bank3 native placement.  The wrapper is a name adapter only:
### ddr3_addr[14:0]=mem_a[14:0], and every other DDR port is one-to-one.
### These locations are copied from ip/ddr3/pnr/ddr_test.fdc so that each
### DQ/DQS byte lane remains in its generated DQS group.
define_attribute {p:ddr3_addr[0]} {PAP_IO_LOC} {J7}
define_attribute {p:ddr3_addr[1]} {PAP_IO_LOC} {N7}
define_attribute {p:ddr3_addr[2]} {PAP_IO_LOC} {R4}
