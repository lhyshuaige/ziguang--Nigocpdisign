    <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
        <column_headers>
            <data>Command</data>
        </column_headers>
        <row>
            <data>create_clock -name {clk_50m} [get_ports {clk_50m}] -period {20.000} -waveform {0.000 10.000}</data>
        </row>
        <row>
            <data>create_generated_clock -name {pll_clk_sys} -source [get_ports {clk_50m}] [get_pins {u_clock_reset.u_pgl50h_pll.u_generated_pll/clkout0}] -master_clock [get_clocks {clk_50m}] -multiply_by {2} -divide_by {1}</data>
        </row>
        <row>
            <data>set_clock_groups -name {hmic_ioclk1_async_test} -asynchronous -group [get_clocks {ioclk1}]</data>
        </row>
        <row>
            <data>define_attribute {i:u_ddr3.u_pds_ddr3.u_hmic.u_ipsxb_ddrphy_pll_0.u_pll_e3} {PAP_LOC} {PLL_158_199}</data>
        </row>
        <row>
            <data>define_attribute {i:u_ddr3.u_pds_ddr3.u_hmic.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate} {PAP_LOC} {CLMA_150_192:FF3}</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports {reset_n}]</data>
        </row>
    </table>
