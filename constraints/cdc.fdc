# Native compiled endpoints. No blanket sys100/DDR clock-group cut.
# Only first-stage / held-bus captures from the opposite clock are excepted.
# Later synchronizer stages, same-clock mux feedback and reset recovery remain timed.
# command_toggle_first: 1 capture bits
set_max_delay -datapath_only {8.000} -from [get_clocks {sys100}] -to [get_pins {u_soc_core.g_axi_fabric.u_axi_hmic_cdc.cmd_sync1_dst/D[0]}]
set_false_path -hold -from [get_clocks {sys100}] -to [get_pins {u_soc_core.g_axi_fabric.u_axi_hmic_cdc.cmd_sync1_dst/D[0]}]
# response_toggle_first: 1 capture bits
set_max_delay -datapath_only {8.000} -from [get_clocks {ddrphy_sysclk}] -to [get_pins {u_soc_core.g_axi_fabric.u_axi_hmic_cdc.rsp_sync1_src/D[0]}]
